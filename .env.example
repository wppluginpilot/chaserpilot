# Local development. `shopify app dev` injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET
# and SHOPIFY_APP_URL; you normally only need DATABASE_URL (see `npm run dev:db`).
DATABASE_URL="postgresql://chaserpilot@127.0.0.1:5438/chaserpilot?schema=public"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# Daily digest email (optional). MAIL_PROVIDER = resend | brevo | smtp | none (default).
# Primary: Resend over HTTPS (works on Render's free web service, which blocks
# outbound SMTP). See docs/email-setup.md.
#   resend (primary), brevo (alternative): set MAIL_API_KEY and MAIL_FROM.
#   smtp:          local development / paid hosts. Set SMTP_HOST, SMTP_PORT, SMTP_USER,
#                  SMTP_PASS and MAIL_FROM.
#   none:          no email; the in-app Today page is the digest.
MAIL_PROVIDER="resend"
MAIL_API_KEY=""
MAIL_FROM="ChaserPilot <digest@wppluginpilot.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Billing waiver (development stores only). Shopify refuses charges while the
# app is unlisted. Comma-separated shop domains that get Paid without a charge,
# e.g. BILLING_WAIVER_SHOPS="usman-built-this.myshopify.com". Default empty:
# every other store gets Shopify's real error and is never given Paid for free.
BILLING_WAIVER_SHOPS=""

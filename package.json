{
  "name": "chaserpilot",
  "version": "1.0.0",
  "private": true,
  "description": "ChaserPilot - follow-up tasks on Shopify orders and customers, one queue to work every morning.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "shopify app dev",
    "dev:db": "node scripts/dev-postgres.mjs",
    "build": "prisma generate && react-router build",
    "start": "node server.mjs",
    "setup": "prisma generate && prisma migrate deploy",
    "docker-start": "node scripts/migrate-with-retry.mjs && npm run start",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "typecheck": "react-router typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "config:link": "shopify app config link",
    "deploy": "shopify app deploy",
    "shopify": "shopify",
    "prisma": "prisma",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@react-router/express": "7.18.4",
    "@react-router/fs-routes": "7.18.4",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@shopify/app-bridge-react": "^4.2.13",
    "@shopify/shopify-app-react-router": "^3.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "isbot": "^5.1.31",
    "morgan": "^1.12.1",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4",
    "vite-tsconfig-paths": "^6.0.4",
    "zod": "^4.6.5",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@shopify/polaris-types": "^1.0.7",
    "@types/node": "^22.20.3",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "@types/nodemailer": "^6.4.17",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/js": "^9.0.0"
  }
}